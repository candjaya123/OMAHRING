FROM node:20-alpine

WORKDIR /app

# Copy hanya dependency
COPY package*.json ./

# Install production only + clean cache
RUN npm install --omit=dev && npm cache clean --force

# Copy source
COPY . .

# Pakai user non-root
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 5005

CMD ["node", "server.js"]